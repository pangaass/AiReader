    .provenance-graph{position:relative;overflow:hidden}.component-head p{margin:4px 0 0;color:var(--muted);font-size:13px}.provenance-zoom{display:flex;gap:5px}.provenance-zoom button,.provenance-filters button{min-height:36px;padding:6px 11px;border:1px solid var(--line);border-radius:999px;background:var(--paper);color:var(--ink);cursor:pointer}.provenance-zoom button{min-width:38px}.provenance-filters{display:flex;gap:7px;overflow-x:auto;margin:14px 0 12px;padding-bottom:4px}.provenance-filters button{display:flex;align-items:center;gap:6px;white-space:nowrap;font-size:12px}.provenance-filters button.active{border-color:var(--ink);background:var(--ink);color:var(--paper)}.relation-dot{display:inline-block;width:8px;height:8px;border-radius:50%;background:currentColor}.relation-same_problem{--relation:#7656b3}.relation-improvement_comparison{--relation:var(--red)}.relation-foundation_inheritance{--relation:var(--green)}.relation-data_evaluation{--relation:var(--blue)}.provenance-viewport{position:relative;height:620px;overflow:hidden;border:1px solid var(--line);border-radius:14px;background-color:var(--bg);background-image:radial-gradient(var(--line) .8px,transparent .8px);background-size:20px 20px;cursor:grab;touch-action:none}.provenance-viewport.dragging{cursor:grabbing}.provenance-world{position:absolute;left:0;top:0;transform-origin:0 0;will-change:transform}.provenance-edges{position:absolute;inset:0;overflow:visible;pointer-events:none}.provenance-edge{fill:none;stroke:var(--relation);stroke-width:2.2;opacity:.55}.provenance-edge.provenance-trunk{stroke-width:3.2;opacity:.78}.provenance-lane{position:absolute;left:16px;width:1018px;border-top:1px dashed color-mix(in srgb,var(--relation),transparent 55%);border-bottom:1px dashed color-mix(in srgb,var(--relation),transparent 72%);background:color-mix(in srgb,var(--relation),transparent 96%);pointer-events:none}.provenance-lane>span{position:absolute;left:13px;top:8px;color:var(--relation);font-size:11px;fon