{% import "components.html.j2" as ui %}
<!doctype html>
<html lang="zh-CN" data-theme="light">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <meta name="generator" content="Paper Visualizer {{ generator_version }}">
  <title>{{ model.paper.title }} · Paper Visualizer</title>
  <style>
    :root{--bg:#f3f0e8;--paper:#fffdf7;--soft:#e9e5da;--ink:#17211c;--muted:#647169;--line:#d2cec2;--green:#176b4b;--green-soft:#dcece3;--blue:#315ea8;--blue-soft:#e1e9f7;--orange:#b95d26;--orange-soft:#f7e2d2;--red:#a73932;--shadow:0 18px 55px rgba(28,38,32,.1);--sans:Inter,-apple-system,BlinkMacSystemFont,"Segoe UI","Noto Sans SC",sans-serif;--serif:"Iowan Old Style","Songti SC",serif}
    html[data-theme=dark]{--bg:#121714;--paper:#1b221e;--soft:#252d28;--ink:#edf3ef;--muted:#a9b6ae;--line:#4a564f;--green:#76d6aa;--green-soft:#173c2d;--blue:#9ac0f3;--blue-soft:#1d3150;--orange:#efa16a;--orange-soft:#492d1e;--red:#ef8e86;--shadow:0 18px 55px rgba(0,0,0,.3)}
    *{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;overflow-x:hidden;background:var(--bg);color:var(--ink);font:16px/1.62 var(--sans)}button,a{font:inherit}a{color:var(--blue)}button:focus-visible,a:focus-visible,[tabindex]:focus-visible{outline:3px solid var(--blue);outline-offset:3px}.skip{position:fixed;left:12px;top:-60px;z-index:100;padding:10px 14px;background:var(--ink);color:var(--paper);border-radius:8px}.skip:focus{top:12px}
    .progress{position:fixed;top:0;left:0;z-index:80;width:100%;height:3px;background:transparent}.progress span{display:block;width:0;height:100%;background:var(--orange)}.top{position:sticky;top:0;z-index:50;border-bottom:1px solid var(--line);background:var(--bg);background:color-mix(in srgb,var(--bg),transparent 7%);backdrop-filter:blur(14px)}.top-inner,main,.footer-inner{width:min(1120px,calc(100% - 32px));margin:auto;min-width:0}.top-inner{min-height:62px;display:flex;align-items:center;gap:14px}.brand{font-weight:850;letter-spacing:-.03em;white-space:nowrap}.brand b{color:var(--orange)}nav{display:flex;gap:3px;overflow-x:auto;margin-left:auto;scrollbar-width:thin}nav a{padding:8px 9px;border-radius:8px;color:var(--muted);font-size:13px;text-decoration:none;white-space:nowrap}nav a:hover,nav a.active{background:var(--soft);color:var(--ink)}.round-action{display:grid;place-items:center;width:42px;height:42px;min-width:42px;padding:0;border:1px solid var(--line);border-radius:50%;background:var(--paper);color:var(--ink);cursor:pointer;text-decoration:none}
    section{min-width:0;padding:52px 0;border-top:1px solid var(--line);scroll-margin-top:78px}.hero{min-height:390px;padding:64px 0 54px;border:0}.eyebrow,.section-no,.component-label{color:var(--orange);font-size:12px;font-weight:800;letter-spacing:.1em;text-transform:uppercase}.hero h1{max-width:900px;margin:14px 0 22px;font:clamp(38px,5vw,64px)/1.04 var(--serif);letter-spacing:-.048em;text-wrap:balance}.paper-meta{color:var(--muted);font-size:14px}.paper-meta strong{color:var(--ink)}.metadata-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:12px;margin-top:28px}.metadata-item{padding:14px 16px;border:1px solid var(--line);border-radius:13px;background:var(--paper)}.metadata-item b{display:block;margin-bottom:4px;color:var(--muted);font-size:11px;letter-spacing:.08em;text-transform:uppercase}.metadata-item span{display:block;overflow-wrap:anywhere}.metadata-wide{grid-column:1/-1}
    .section-head{display:grid;grid-template-columns:130px minmax(0,1fr);gap:20px;margin-bottom:22px}.section-head h2{margin:0 0 7px;font:clamp(28px,3.4vw,40px)/1.1 var(--serif);letter-spacing:-.03em}.section-head p{max-width:720px;margin:0;color:var(--muted)}.section-components{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}.section-components>*:only-child,.section-components>.paper-figure,.section-components>.paper-table,.section-components>.derived-visual,.section-components>.related-stack,.section-components>.quick-read-grid,.section-components>.story-flow{grid-column:1/-1}.panel{min-width:0;padding:18px;border:1px solid var(--line);border-radius:16px;background:var(--paper)}.panel h3{margin:0 0 9px}.summary-card p,.citation-card p{color:var(--muted)}.story-flow{--story-accent:var(--green);padding:4px 18px}.story-flow-research_task{--story-accent:var(--orange)}.story-flow-motivation{--story-accent:#7656b3}.story-flow-method_overview,.story-flow-method_details{--story-accent:var(--green)}.story-flow-training_inference{--story-accent:var(--blue)}.story-flow-experimental_setup{--story-accent:#8b5a2b}.story-flow-main_results{--story-accent:var(--red)}.story-flow-analysis,.story-flow-conclusion_limitations{--story-accent:#596960}.story-step{position:relative;display:grid;grid-template-columns:28px minmax(0,1fr);gap:12px;padding:15px 0;cursor:pointer}.story-step+.story-step{border-top:1px solid var(--line)}.story-marker{position:relative;z-index:1;display:grid;place-items:center;width:26px;height:26px;margin-top:2px;border:2px solid var(--story-accent);border-radius:50%;background:var(--paper);color:var(--story-accent);font-size:11px;font-weight:850}.story-step:not(:last-child) .story-marker:after{content:"";position:absolute;top:24px;bottom:-24px;left:50%;border-left:2px solid var(--story-accent);opacity:.35}.story-copy>span{color:var(--story-accent);font-size:11px;font-weight:850;letter-spacing:.08em}.story-copy h3{margin:3px 0 4px;font-size:17px}.story-copy p{margin:0;color:var(--muted);font-size:14px;line-height:1.58}.quick-read-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));padding:0;overflow:hidden}.quick-read-cell{min-width:0;padding:20px;cursor:pointer}.quick-read-cell+ .quick-read-cell{border-left:1px solid var(--line)}.quick-read-cell>span{color:var(--orange);font-size:12px;font-weight:850;letter-spacing:.08em}.quick-read-cell h3{margin:7px 0 8px;font-size:17px}.quick-read-cell p{margin:0;color:var(--muted);font-size:14px;line-height:1.6}[data-source-page]{cursor:pointer}.source-actions{display:flex;flex-wrap:wrap;gap:7px}.source-chip,.text-button{border:0;background:transparent;color:var(--blue);font-weight:750;cursor:pointer;text-decoration:underline;text-underline-offset:3px}.source-chip{min-height:40px;padding:7px 10px;border:1px solid var(--line);border-radius:999px;background:var(--paper);text-decoration:none}.empty-state{grid-column:1/-1;padding:20px;border:1px dashed var(--line);border-radius:14px;color:var(--muted)}
    .component-head{display:flex;align-items:flex-start;justify-content:space-between;gap:16px;margin-bottom:12px}.component-head h3{margin:4px 0 0}.page-link,.page-text{white-space:nowrap;font-size:13px}.original-label{color:var(--green)}.derived-label{color:var(--blue)}.formula-card{grid-column:1/-1}.formula-scroll,.scroll-region{max-width:100%;overflow-x:auto}.formula-scroll{padding:20px 16px 13px;background:var(--soft);border-radius:12px;scrollbar-width:thin}.formula-scroll math{min-width:max-content;margin:auto;font-size:clamp(21px,3vw,34px);font-family:"STIX Two Math","Cambria Math",serif}.formula-scroll mtext{white-space:pre}.math-var{color:var(--ink);cursor:pointer}.math-var:hover,.math-var:focus{color:var(--blue);text-decoration:underline;text-decoration-style:dotted;text-underline-offset:5px}.render-note{margin:10px 0 0;color:var(--red);font-size:12px}
    figure{margin:0}.image-open{display:block;width:100%;padding:0;border:0;border-radius:11px;background:#fff;cursor:zoom-in;overflow:hidden}.image-open img{display:block;width:100%;max-height:580px;object-fit:contain}.asset-missing{display:grid;place-items:center;min-height:220px;padding:20px;border:1px dashed var(--line);border-radius:11px;color:var(--muted)}figcaption{display:flex;justify-content:space-between;gap:14px;margin-top:12px;padding-top:10px;border-top:1px solid var(--line);color:var(--muted);font:13px/1.55 var(--serif)}figcaption b{color:var(--ink)}
    table{width:100%;border-collapse:collapse;font-size:14px}th,td{padding:10px 9px;border-bottom:1px solid var(--line);text-align:left;vertical-align:top}th{color:var(--muted);font-size:12px;letter-spacing:.05em}.paper-table table{min-width:650px}.cell-evidence{width:100%;padding:5px;border:1px solid var(--blue);border-radius:7px;background:var(--blue-soft);color:var(--ink);cursor:pointer}.visual-scroll svg{display:block;width:100%;min-width:720px;height:auto;max-height:580px}.graph-edge{stroke:var(--line);stroke-width:3;fill:none}.graph-edge.dashed{stroke-dasharray:10 9}.graph-node rect{fill:var(--soft);stroke:var(--line);stroke-width:2}.graph-node.interactive rect{fill:var(--blue-soft);stroke:var(--blue)}.graph-node text,.graph-mark text{fill:var(--ink);font:700 16px var(--sans);text-anchor:middle;dominant-baseline:middle}.graph-node.interactive,.graph-mark.interactive{cursor:pointer}.graph-mark rect{fill:var(--blue)}.graph-mark.interactive rect{fill:var(--green)}.graph-mark text{font-size:13px}.graph-mark text:last-child{fill:var(--muted)}.derived-visual figcaption{display:block}
    .related-stack{display:grid;gap:18px}.related-map{overflow:hidden}.relation-groups{display:grid;grid-template-columns:repeat(4,minmax(230px,1fr));gap:12px;overflow-x:auto;padding-bottom:8px}.relation-group{min-width:0;border:1px solid var(--line);border-top:5px solid var(--blue);border-radius:14px;background:var(--bg);overflow:hidden}.relation-foundation_inheritance{border-top-color:var(--green)}.relation-same_problem{border-top-color:#7656b3}.relation-improvement_comparison{border-top-color:var(--red)}.relation-data_evaluation{border-top-color:var(--blue)}.relation-heading{display:grid;grid-template-columns:24px minmax(0,1fr) auto;gap:8px;align-items:start;padding:12px;border-bottom:1px solid var(--line)}.relation-heading>span{display:grid;place-items:center;width:24px;height:24px;border-radius:50%;background:var(--soft);color:var(--orange);font-size:11px;font-weight:900}.relation-heading h4{margin:0;font-size:15px}.relation-heading p{margin:3px 0 0;color:var(--muted);font-size:11px;line-height:1.45}.relation-heading>b{display:grid;place-items:center;min-width:24px;height:24px;border-radius:50%;background:var(--soft);font-size:11px}.relation-papers{display:grid}.relation-paper{display:grid;grid-template-columns:minmax(0,1fr) 28px;gap:7px;align-items:start;padding:11px 12px;border-bottom:1px solid var(--line);cursor:pointer}.relation-paper:last-child{border-bottom:0}.relation-paper>div{display:grid;gap:3px;min-width:0}.relation-paper span{color:var(--muted);font-size:10px}.relation-paper strong{font-size:13px;line-height:1.4;overflow-wrap:anywhere}.relation-paper p{display:-webkit-box;overflow:hidden;margin:0;color:var(--muted);font:11px/1.45 var(--serif);-webkit-box-orient:vertical;-webkit-line-clamp:2}.relation-paper>a{display:grid;place-items:center;width:28px;height:28px;border:1px solid var(--line);border-radius:50%;text-decoration:none}.relation-more{padding:9px 12px;color:var(--muted);font-size:11px}.relation-merge{position:relative;height:50px;text-align:center}.relation-merge:before{content:"";position:absolute;left:8%;right:8%;top:16px;border-top:2px solid var(--line)}.relation-merge:after{content:"";position:absolute;left:50%;top:16px;height:16px;border-left:2px solid var(--orange)}.relation-merge span{position:absolute;left:8%;top:0;bottom:32px;border-left:2px solid var(--line)}.relation-merge b{position:relative;top:29px;padding:3px 8px;border-radius:999px;background:var(--orange-soft);color:var(--orange);font-size:10px}.related-current{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:4px 12px;width:min(760px,100%);margin:0 auto;padding:14px 16px;border:2px solid var(--orange);border-radius:14px;background:var(--orange-soft)}.related-current>div:first-child{display:grid}.related-current b{font-size:11px;color:var(--orange)}.related-current span{min-width:0}.related-current time{color:var(--muted)}.current-focus{grid-column:1/-1;display:flex!important;flex-wrap:wrap;gap:6px;margin-top:6px}.current-focus span{padding:3px 8px;border:1px solid var(--line);border-radius:999px;background:var(--paper);font-size:11px}.related-empty{padding:18px;border:1px dashed var(--line);border-radius:12px;color:var(--muted)}.relation-table{padding:0;overflow:hidden}.relation-table>summary{padding:13px 15px;cursor:pointer;font-weight:750}.relation-table[open]>summary{border-bottom:1px solid var(--line)}.relation-row{display:grid;grid-template-columns:minmax(0,2fr) minmax(90px,1fr) minmax(80px,.8fr);gap:12px;align-items:center;padding:10px 14px;border-top:1px solid var(--line);cursor:pointer;font-size:12px}.relation-row:first-child{border-top:0}.relation-row>span:first-child{display:flex;align-items:center;gap:8px;min-width:0}.relation-row b{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.relation-row small{color:var(--muted)}.relation-table-head{background:var(--soft);color:var(--muted);font-size:10px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;cursor:default}.verification{float:right;color:var(--muted);font-size:12px}.citation-actions{display:flex;align-items:center;justify-content:space-between;gap:10px}
    .evidence-card{position:fixed;right:22px;bottom:22px;z-index:70;width:min(430px,calc(100% - 44px));max-height:min(62vh,520px);overflow:auto;padding:18px;border:1px solid var(--line);border-radius:17px;background:var(--paper);box-shadow:var(--shadow)}.evidence-card[hidden]{display:none}.card-actions{display:flex;justify-content:flex-end;gap:8px;margin-bottom:12px}.evidence-card blockquote{margin:0;font:18px/1.58 var(--serif)}.evidence-card strong{color:var(--orange)}dialog{width:min(920px,calc(100% - 28px));max-height:90vh;padding:0;border:1px solid var(--line);border-radius:18px;background:var(--paper);color:var(--ink);box-shadow:var(--shadow)}dialog::backdrop{background:rgba(12,18,14,.72)}.dialog-head{position:sticky;top:0;z-index:2;display:flex;align-items:center;gap:9px;padding:14px 18px;border-bottom:1px solid var(--line);background:var(--paper)}.dialog-head strong{margin-right:auto}.dialog-body{padding:20px;overflow:auto}.dialog-body img{display:block;width:100%;max-height:68vh;object-fit:contain;background:#fff}.dialog-caption{margin:12px 0 0;color:var(--muted);font:14px/1.55 var(--serif)}footer{padding:30px 0 48px;border-top:1px solid var(--line);color:var(--muted);font-size:13px}
    @media(max-width:800px){.hero{min-height:0}.section-components{grid-template-columns:1fr}.section-components>*{grid-column:1}.section-head{grid-template-columns:1fr;gap:6px}}
    @media(max-width:620px){.top-inner,main,.footer-inner{width:min(100% - 22px,1120px)}.top-inner{flex-wrap:wrap;gap:6px;padding:7px 0}.brand{font-size:14px}.top-inner .round-action{margin-left:auto}.top-inner nav{order:3;width:100%;margin:0;padding-right:22px;mask-image:linear-gradient(to right,#000 88%,transparent)}.top-inner nav a{padding:5px 9px}section{padding:42px 0}.hero{padding:32px 0 38px;gap:28px}.hero h1{font-size:clamp(30px,9vw,36px);line-height:1.06}.hero-question{padding:17px}.panel{padding:14px}.quick-read-grid{padding:0}.quick-read-cell{padding:14px 12px}.quick-read-cell h3{font-size:15px}.quick-read-cell p{font-size:13px;line-height:1.5}.formula-scroll{padding:17px 12px 11px}.formula-scroll math{font-size:20px}.related-current{align-items:flex-start;flex-wrap:wrap}.related-current time{margin-left:0}.relation-branch{height:24px}.relation-branch span{display:none}.relation-group:before{display:none}.evidence-card{left:11px;right:11px;bottom:11px;width:auto;max-height:58vh}figcaption{display:block}.visual-scroll svg{min-width:680px}.round-action{width:44px;height:44px;min-width:44px}}
    @media(max-width:420px){.quick-read-grid{grid-template-columns:1fr}.quick-read-cell+ .quick-read-cell{border-left:0;border-top:1px solid var(--line)}}
    @media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*{transition:none!important;animation:none!important}}
  </style>
</head>
<body>
  <a class="skip" href="#main">跳到正文</a><div class="progress" aria-hidden="true"><span id="readingProgress"></span></div>
  <header class="top"><div class="top-inner"><div class="brand">Paper<b>·</b>Visualizer{% if model.preview %} · 预览{% endif %}</div><nav aria-label="章节导航">{% for link in model.navigation %}<a href="#{{ link.id }}">{{ link.label }}</a>{% endfor %}</nav><button class="round-action" id="themeToggle" type="button" aria-label="切换深浅主题" aria-pressed="false">◐</button></div></header>
  <main id="main">
    <section class="hero" id="paper-identity"><div class="eyebrow">Paper Metadata</div><h1>{{ model.paper.title }}</h1><div class="metadata-grid">{% if model.paper.authors %}<div class="metadata-item metadata-wide" data-source-page="1" role="button" tabindex="0"><b>作者</b><span>{{ model.paper.authors|join('、') }}</span></div>{% endif %}{% if model.paper.affiliations %}<div class="metadata-item metadata-wide" data-source-page="1" role="button" tabindex="0"><b>机构</b><span>{{ model.paper.affiliations|join('；') }}</span></div>{% endif %}{% if model.paper.venue %}<div class="metadata-item" data-source-page="1" role="button" tabindex="0"><b>期刊 / 会议</b><span>{{ model.paper.venue }}</span></div>{% endif %}{% if model.paper.published_at or model.paper.year %}<div class="metadata-item" data-source-page="1" role="button" tabindex="0"><b>发表时间</b><span>{{ model.paper.published_at or model.paper.year }}</span></div>{% endif %}{% if model.paper.doi %}<div class="metadata-item" data-source-page="1" role="button" tabindex="0"><b>DOI</b><span>{{ model.paper.doi }}</span></div>{% endif %}{% if model.paper.arxiv_id %}<div class="metadata-item" data-source-page="1" role="button" tabindex="0"><b>arXiv</b><span>{{ model.paper.arxiv_id }}</span></div>{% endif %}{% if model.paper.page_count %}<div class="metadata-item"><b>篇幅</b><span>{{ model.paper.page_count }} 页</span></div>{% endif %}</div></section>
    {% for section in model.sections %}<section id="{{ section.id }}" data-section-kind="{{ section.kind }}"><div class="section-head"><div class="section-no">{{ section.number }} · {{ section.kind|replace('_',' ') }}</div><div><h2>{{ section.title }}</h2><p>{{ section.intro }}</p></div></div><div class="section-components">{% if section.components %}{% if section.kind == 'one_minute_read' %}{{ ui.quick_read(section.components) }}{% else %}{% set narratives = section.components|selectattr('component','equalto','narrative')|list %}{% if narratives %}{{ ui.narrative_flow(narratives, section.kind) }}{% endif %}{% for item in section.components %}{% if item.component != 'narrative' %}{{ ui.component(item) }}{% endif %}{% endfor %}{% endif %}{% else %}<div class="empty-state">{{ section.fallback_reason or '本论文没有可安全展示的已验证内容。' }}</div>{% endif %}</div></section>{% endfor %}
  </main>
  <footer><div class="footer-inner">此页面由结构化论文数据生成；所有解释、图表和公式均可回到论文原文核对。</div></footer>

  <aside class="evidence-card" id="evidenceCard" role="dialog" aria-modal="false" aria-label="论文原文" hidden><div class="card-actions"><button class="round-action" id="evidenceClose" type="button" aria-label="关闭论文原文">×</button><a class="round-action" id="evidenceJump" target="_blank" rel="noopener noreferrer" aria-label="跳转到 PDF 对应页">↗</a></div><blockquote id="evidenceQuote"></blockquote></aside>
  <dialog id="imageDialog" aria-labelledby="imageDialogTitle"><div class="dialog-head"><strong id="imageDialogTitle">论文原图</strong><a class="round-action" id="imageJump" target="_blank" rel="noopener noreferrer" aria-label="跳转到 PDF 对应页">↗</a><button class="round-action" id="imageClose" type="button" aria-label="关闭原图">×</button></div><div class="dialog-body"><img id="imageLarge" alt="论文原图放大预览"><p class="dialog-caption" id="imageCaption"></p></div></dialog>
  <script type="application/json" id="evidenceRegistry">{{ evidence_json|safe }}</script>
  {% if embedded_pdf_base64 %}<script type="application/json" id="embeddedPdf">{{ embedded_pdf_base64 }}</script>{% endif %}
  <script>
  (()=>{'use strict';
    const q=(s,r=document)=>r.querySelector(s), qa=(s,r=document)=>[...r.querySelectorAll(s)];
    const evidence=JSON.parse(q('#evidenceRegistry').textContent||'{}');
    const pdfNode=q('#embeddedPdf'); let pdfUrl=null; let evidenceOpener=null; let imageOpener=null;
    const embeddedPdfUrl=()=>{if(pdfUrl||!pdfNode)return pdfUrl;const raw=atob(pdfNode.textContent.trim());const bytes=new Uint8Array(raw.length);for(let i=0;i<raw.length;i++)bytes[i]=raw.charCodeAt(i);pdfUrl=URL.createObjectURL(new Blob([bytes],{type:'application/pdf'}));return pdfUrl};
    const pageHref=(item)=>item.href||((embeddedPdfUrl()&&item.page)?`${pdfUrl}#page=${item.page}`:null);
    const setJump=(link,href,page)=>{if(href){link.href=href;link.removeAttribute('aria-disabled');link.dataset.pdfPage=page||''}else{link.removeAttribute('href');link.setAttribute('aria-disabled','true');link.dataset.pdfPage=page||''}};
    const theme=q('#themeToggle');try{const saved=localStorage.getItem('paper-visualizer-theme');if(saved==='dark')document.documentElement.dataset.theme='dark'}catch(_){}theme.setAttribute('aria-pressed',String(document.documentElement.dataset.theme==='dark'));theme.addEventListener('click',()=>{const dark=document.documentElement.dataset.theme!=='dark';document.documentElement.dataset.theme=dark?'dark':'light';theme.setAttribute('aria-pressed',String(dark));try{localStorage.setItem('paper-visualizer-theme',dark?'dark':'light')}catch(_){}});
    const progress=q('#readingProgress');const updateProgress=()=>{const height=document.documentElement.scrollHeight-innerHeight;progress.style.width=(height>0?Math.min(100,scrollY/height*100):0)+'%'};addEventListener('scroll',updateProgress,{passive:true});updateProgress();
    const navLinks=qa('nav a');if('IntersectionObserver'in window){const observer=new IntersectionObserver(entries=>entries.forEach(entry=>{if(entry.isIntersecting)navLinks.forEach(link=>link.classList.toggle('active',link.hash==='#'+entry.target.id))}),{rootMargin:'-30% 0px -60%'});qa('main section[id]').forEach(section=>observer.observe(section))}
    const card=q('#evidenceCard'),quote=q('#evidenceQuote'),close=q('#evidenceClose'),jump=q('#evidenceJump');
    const renderQuote=(text,symbol)=>{quote.replaceChildren();if(!symbol){quote.textContent=text;return}const index=text.indexOf(symbol);if(index<0){quote.textContent=text;return}quote.append(document.createTextNode(text.slice(0,index)));const strong=document.createElement('strong');strong.textContent=symbol;quote.append(strong,document.createTextNode(text.slice(index+symbol.length)))};
    const closeEvidence=()=>{if(card.hidden)return;card.hidden=true;const opener=evidenceOpener;evidenceOpener=null;if(opener&&opener.isConnected)opener.focus()};
    const openEvidence=(trigger)=>{const item=evidence[trigger.dataset.evidenceId];if(!item)return;evidenceOpener=trigger;renderQuote(item.verbatim_text,trigger.dataset.variableSymbol||'');setJump(jump,pageHref(item),item.page);card.hidden=false;close.focus()};
    qa('[data-evidence-id]').forEach(trigger=>{trigger.addEventListener('click',()=>openEvidence(trigger));trigger.addEventListener('keydown',event=>{if((event.key==='Enter'||event.key===' ')&&trigger.getAttribute('role')==='button'){event.preventDefault();openEvidence(trigger)}})});close.addEventListener('click',closeEvidence);
    qa('.relation-paper>a').forEach(link=>link.addEventListener('click',event=>event.stopPropagation()));
    card.addEventListener('keydown',event=>{if(event.key==='Escape'){event.preventDefault();closeEvidence();return}if(event.key==='Tab'){const actions=qa('button:not([disabled]),a[href]',card);if(!actions.length)return;const first=actions[0],last=actions[actions.length-1];if(event.shiftKey&&document.activeElement===first){event.preventDefault();last.focus()}else if(!event.shiftKey&&document.activeElement===last){event.preventDefault();first.focus()}}});
    jump.addEventListener('click',event=>{if(jump.getAttribute('aria-disabled')==='true')event.preventDefault()});
    const dialog=q('#imageDialog'),large=q('#imageLarge'),caption=q('#imageCaption'),imageTitle=q('#imageDialogTitle'),imageJump=q('#imageJump'),imageClose=q('#imageClose');
    qa('.image-open').forEach(button=>button.addEventListener('click',()=>{imageOpener=button;const thumb=q('img',button);large.src=thumb?thumb.src:'';large.alt=button.dataset.imageAlt||'';imageTitle.textContent=button.dataset.imageTitle||'论文原图';caption.textContent=button.dataset.imageCaption||'';const page=button.dataset.imagePage;setJump(imageJump,button.dataset.imageHref||((embeddedPdfUrl()&&page)?`${pdfUrl}#page=${page}`:null),page);dialog.showModal();imageClose.focus()}));
    imageClose.addEventListener('click',()=>dialog.close());dialog.addEventListener('cancel',event=>{event.preventDefault();dialog.close()});dialog.addEventListener('close',()=>{large.removeAttribute('src');if(imageOpener&&imageOpener.isConnected)imageOpener.focus();imageOpener=null});imageJump.addEventListener('click',event=>{if(imageJump.getAttribute('aria-disabled')==='true')event.preventDefault()});
    addEventListener('beforeunload',()=>{if(pdfUrl)URL.revokeObjectURL(pdfUrl)});
  })();
  </script>
</body>
</html>
