der-radius:14px;background:var(--paper);box-shadow:var(--shadow)}.provenance-detail[hidden]{display:none}.provenance-detail-close{float:right;width:32px;height:32px;border:1px solid var(--line);border-radius:50%;background:var(--paper);color:var(--ink);cursor:pointer}.provenance-detail>small{color:var(--muted)}.provenance-detail h4{margin:4px 34px 8px 0;font-size:16px}.provenance-detail p{margin:0 0 8px;color:var(--relation,var(--blue));font-size:12px;font-weight:800}.provenance-detail blockquote{margin:0 0 11px;color:var(--muted);font:13px/1.55 var(--serif)}.provenance-detail>div{display:flex;align-items:center;gap:14px}.provenance-detail a{font-size:13px;font-weight:750}.evidence-card{position:fixed;right:22px;bottom:22px;z-index:70;width:min(430px,calc(100% - 44px));max-height:min(62vh,520px);overflow:auto;padding:18px;border:1px solid var(--line);border-radius:17px;background:var(--paper);box-shadow:var(--shadow)}.evidence-card[hidden]{display:none}.card-actions{display:flex;justify-content:flex-end;gap:8px;margin-bottom:12px}.evidence-card blockquote{margin:0;font:18px/1.58 var(--serif)}.evidence-card strong{color:var(--orange)}dialog{width:min(920px,calc(100% - 28px));max-height:90vh;padding:0;border:1px solid var(--line);border-radius:18px;background:var(--paper);color:var(--ink);box-shadow:var(--shadow)}dialog::backdrop{background:rgba(12,18,14,.72)}.dialog-head{position:sticky;top:0;z-index:2;display:flex;align-items:center;gap:9px;padding:14px 18px;border-bottom:1px solid var(--line);background:var(--paper)}.dialog-head strong{margin-right:auto}.dialog-body{padding:20px;overflow:auto}.dialog-body img{display:block;width:100%;max-height:68vh;object-fit:contain;background:#fff}.dialog-caption{margin:12px 0 0;color:var(--muted);font:14px/1.55 var(--serif)}footer{padding:30px 0 48px;border-top:1px solid var(--line);color:var(--muted);font-size:13px}
    @media(max-width:800px){.hero{min-height:0}.section-components{grid-template-columns:1fr}.section-components>*{grid-column:1}.section-head{grid-template-columns:1fr;gap:6px}}
    @media(max-width:620px){.top-inner,main,.footer-inner{width:min(100% - 22px,1120px)}.top-inner{flex-wrap:wrap;gap:6px;padding:7px 0}.brand{font-size:14px}.top-inner .round-action{margin-left:auto}.top-inner nav{order:3;width:100%;margin:0;padding-right:22px;mask-image:linear-gradient(to right,#000 88%,transparent)}.top-inner nav a{padding:5px 9px}section{padding:42px 0}.hero{padding:32px 0 38px;gap:28px}.hero h1{font-size:clamp(30px,9vw,36px);line-height:1.06}.hero-question{padding:17px}.panel{padding:14px}.quick-read-grid{padding:0}.quick-read-cell{padding:14px 12px}.quick-read-cell h3{font-size:15px}.quick-read-cell p{font-size:13px;line-height:1.5}.argument-chain{padding:10px}.execution-track{grid-template-columns:1fr}.track-label{padding:0}.diagnostic-matrix,.boundary-map{grid-template-columns:1fr}.boundary-axis{display:none}.formula-scroll{padding:17px 12px 11px}.formula-scroll math{font-size:20px}.related-current{align-items:flex-start;flex-wrap:wrap}.relation-branch{height:24px}.relation-branch span{display:none}.relation-group:before{display:none}.evidence-card{left:11px;right:11px;bottom:11px;width:auto;max-height:58vh}figcaption{display:block}.visual-scroll svg{min-width:680px}.round-action{width:44px;height:44px;min-width:44px}}
    @media(max-width:420px){.quick-read-grid{grid-template-columns:1fr}.quick-read-cell+ .quick-read-cell{border-left:0;border-top:1px solid var(--line)}}
    @media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*{transition:none!important;animation:none!important}}
  </style>
</head>
<body>
  <a class="skip" href="#main">跳到正文</a><div class="progress" aria-hidden="true"><span id="readingProgress"></span></div>
  <header class="top"><div class="top-inner"><div class="brand">Paper<b>·</b>Visualizer{% if model.preview %} · 预览{% endif %}</div><nav aria-label="章节导航">{% for link in model.navigation %}<a href="#{{ link.id }}">{{ link.label }}</a>{% endfor %}</nav><button class="round-action" id="themeToggle" type="button" aria-label="切换深浅主题" aria-pressed="false">◐</button></div></header>
  <main id="main">
    <section class="hero" id="paper-identity"><div class="eyebrow">Paper Metadata</div><h1>{{ model.paper.title }}</h1><div class="metadata-grid">{% if model.paper.authors %}<div class="metadata-item metadata-wide" data-source-page="1" role="button" tabindex="0"><b>作者</b><span>{{ model.paper.authors|join('、') }}</span></div>{% endif %}{% if model.paper.affiliations %}<div class="metadata-item metadata-wide" data-source-page="1" role="button" tabindex="0"><b>机构</b><span>{{ model.paper.affiliations|join('；') }}</span></div>{% endif %}{% if model.paper.venue %}<div class="metadata-item" data-source-page="1" role="button" tabindex="0"><b>期刊 / 会议</b><span>{{ model.paper.venue }}</span></div>{% endif %}{% if model.paper.published_at or model.paper.year %}<div class="metadata-item" data-source-page="1" role="button" tabindex="0"><b>发表时间</b><span>{{ model.paper.published_at or model.paper.year }}</span></div>{% endif %}{% if model.paper.doi %}<div class="metadata-item" data-source-page="1" role="button" tabindex="0"><b>DOI</b><span>{{ model.paper.doi }}</span></div>{% endif %}{% if model.paper.arxiv_id %}<div class="metadata-item" data-source-page="1" role="button" tabindex="0"><b>arXiv</b><span>{{ model.paper.arxiv_id }}</span></div>{% endif %}{% if model.paper.page_count %}<div class="metadata-item"><b>篇幅</b><span>{{ model.paper.page_count }} 页</span></div>{% endif %}</div></section>
    {% for section in model.sections %}<section id="{{ section.id }}" data-section-kind="{{ section.kind }}" data-presentation="{{ section.presentation }}"><div class="section-head"><div class="section-no">{{ section.number }} · {{ section.kind|replace('_',' ') }}</div><div><h2>{{ section.title }}</h2><p>{{ section.intro }}</p></div></div><div class="section-components">{% if section.components %}{% if section.kind == 'one_minute_read' %}{{ ui.quick_read(section.components) }}{% else %}{% set narratives = section.components|selectattr('component','equalto','narrative')|list %}{% if narratives %}{{ ui.narrative_group(narratives, section.kind, section.presentation) }}{% endif %}{% for item in section.components %}{% if item.component != 'narrative' %}{{ ui.component(item) }}{% endif %}{% endfor %}{% endif %}{% else %}<div class="empty-state">{{ section.fallback_reason or '本论文没有可安全展示的已验证内容。' }}</div>{% endif %}</div></section>{% endfor %}
  </main>
  <footer><div class="footer-inner">此页面由结构化论文数据生成；所有解释、图表和公式均可回到论文原文核对。</div></footer>

  <aside class="evidence-card" id="evidenceCard" role="dialog" aria-modal="false" aria-label="论文原文" hidden><div class="card-actions"><button class="round-action" id="evidenceClose" type="button" aria-label="关闭论文原文">×</button><a class="round-action" id="evidenceJump" target="_blank" rel="noopener noreferrer" aria-label="跳转到 PDF 对应页">↗</a></div><blockquote id="evidenceQuote"></blockquote></aside>
  <dialog id="imageDialog" aria-labelledby="imageDialogTitle"><div class="dialog-head"><strong id="imageDialogTitle">论文原图</strong><a class="round-action" id="imageJump" target="_blank" rel="noopener noreferrer" aria-label="跳转到 PDF 对应页">↗</a><button class="round-action" id="imageClose" type="button" aria-label="关闭原图">×</button></div><div class="dialog-body"><img id="imageLarge" alt="论文原图放大预览"><p class="dialog-caption" id="imageCaption"></p></div></dialog>
  <script type="application/json" id="evidenceRegistry">{{ evidence_json|safe }}</script>
  {% if embedded_pdf_base64 %}<script type="application/json" id="embeddedPdf">{{ embedded_pdf_base64 }}</script>{% endif %}
  <script>
  (()=>{'use strict';
    const q=(s,r=document)=>r.querySelector(s), qa=(s,r=document)=>[...r.querySelectorAll(s)];
    const evidence=JSON.parse(q('#evidenceRegistry').textContent||'{}');
    const pdfNode=q('#embeddedPdf'); let pdfUrl=null; let evidenceOpener=null; let imageOpener=null;
    const embeddedPdfUrl=()=>{if(pdfUrl||!pdfNode)return pdfUrl;const raw=atob(pdfNode.textContent.trim());const bytes=new Uint8Array(raw.length);for(let i=0;i<raw.length;i++)bytes[i]=raw.charCodeAt(i);pdfUrl=URL.createObjectURL(new Blob([bytes],{type:'application/pdf'}));return pdfUrl};
    const pageHref=(item)=>item.href||((embeddedPdfUrl()&&item.page)?`${pdfUrl}#page=${item.page}`:null);
    const setJump=(link,href,page)=>{if(href){link.href=href;link.removeAttribute('aria-disabled');link.dataset.pdfPage=page||''}else{link.removeAttribute('href');link.setAttribute('aria-disabled','true');link.dataset.pdfPage=page||''}};
    const theme=q('#themeToggle');try{const saved=localStorage.getItem('paper-visualizer-theme');if(saved==='dark')document.documentElement.dataset.theme='dark'}catch(_){}theme.setAttribute('aria-pressed',String(document.documentElement.dataset.theme==='dark'));theme.addEventListener('click',()=>{const dark=document.documentElement.dataset.theme!=='dark';document.documentElement.dataset.theme=dark?'dark':'light';theme.setAttribute('aria-pressed',String(dark));try{localStorage.setItem('paper-visualizer-theme',dark?'dark':'light')}catch(_){}});
    const progress=q('#readingProgress');const updateProgress=()=>{const height=document.documentElement.scrollHeight-innerHeight;progress.style.width=(height>0?Math.min(100,scrollY/height*100):0)+'%'};addEventListener('scroll',updateProgress,{passive:true});updateProgress();
    const navLinks=qa('nav a');if('IntersectionObserver'in window){const observer=new IntersectionObserver(entries=>entries.forEach(entry=>{if(entry.isIntersecting)navLinks.forEach(link=>link.classList.toggle('active',link.hash==='#'+entry.target.id))}),{rootMargin:'-30% 0px -60%'});qa('main section[id]').forEach(section=>observer.observe(section))}
    const card=q('#evidenceCard'),quote=q('#evidenceQuote'),close=q('#evidenceClose'),jump=q('#evidenceJump');
    const renderQuote=(text,symbol)=>{quote.replaceChildren();if(!symbol){quote.textContent=text;return}const index=text.indexOf(symbol);if(index<0){quote.textContent=text;return}quote.append(document.createTextNode(text.slice(0,index)));const strong=document.createElement('strong');strong.textContent=symbol;quote.append(strong,document.createTextNode(text.slice(index+symbol.length)))};
    const closeEvidence=()=>{if(card.hidden)return;card.hidden=true;const opener=evidenceOpener;evidenceOpener=null;if(opener&&opener.isConnected)opener.focus()};
    const openEvidence=(trigger)=>{const item=evidence[trigger.dataset.evidenceId];if(!item)return;evidenceOpener=trigger;renderQuote(item.verbatim_text,trigger.dataset.variableSymbol||'');setJump(jump,pageHref(item),item.page);card.hidden=false;close.focus()};
    qa('[data-evidence-id]').forEach(trigger=>{trigger.addEventListener('click',()=>openEvidence(trigger));trigger.addEventListener('keydown',event=>{if((event.key==='Enter'||event.key===' ')&&trigger.getAttribute('role')==='button'){event.preventDefault();openEvidence(trigger)}})});close.addEventListener('click',closeEvidence);
    qa('[data-method-flow]').forEach(flow=>{const figures=qa('.paper-figure',flow.closest('section'));qa('[data-method-step]',flow).forEach(step=>{const activate=()=>figures.forEach(figure=>figure.classList.add('method-linked'));const deactivate=()=>figures.forEach(figure=>figure.classList.remove('method-linked'));step.addEventListener('mouseenter',activate);step.addEventListener('mouseleave',deactivate);step.addEventListener('focus',activate);step.addEventListener('blur',deactivate)})});
    qa('.relation-paper>a').forEach(link=>link.addEventListener('click',event=>event.stopPropagation()));
    qa('[data-provenance-graph]').forEach(graph=>{
      const viewport=q('.provenance-viewport',graph),world=q('.provenance-world',graph),detail=q('.provenance-detail',graph);if(!viewport||!world)return;
      const nodes=new Map(qa('[data-node-id]',world).map(node=>[node.dataset.nodeId,node]));const paths=qa('.provenance-edge',world);let scale=1,tx=0,ty=0,panning=null;
      const applyTransform=()=>{world.style.transform=`translate(${tx}px,${ty}px) scale(${scale})`};
      const updateEdges=()=>paths.forEach(path=>{const source=nodes.get(path.dataset.sourceNode),target=nodes.get(path.dataset.targetNode);if(!source||!target)return;const x1=source.offsetLeft+source.offsetWidth,y1=source.offsetTop+source.offsetHeight/2,x2=target.offsetLeft,y2=target.offsetTop+target.offsetHeight/2,curve=Math.max(42,(x2-x1)*.45);path.setAttribute('d',`M ${x1} ${y1} C ${x1+curve} ${y1}, ${x2-curve} ${y2}, ${x2} ${y2}`)});
      const reset=()=>{const sx=(viewport.clientWidth-28)/world.offsetWidth,sy=(viewport.clientHeight-28)/world.offsetHeight;scale=Math.min(1,sx,sy);tx=Math.max(14,(viewport.clientWidth-world.offsetWidth*scale)/2);ty=Math.max(14,(viewport.clientHeight-world.offsetHeight*scale)/2);applyTransform()};
      const zoom=(factor,cx=viewport.clientWidth/2,cy=viewport.clientHeight/2)=>{const next=Math.min(1.8,Math.max(.38,scale*factor));tx=cx-(cx-tx)*next/scale;ty=cy-(cy-ty)*next/scale;scale=next;applyTransform()};
      updateEdges();reset();
      qa('[data-graph-action]',graph).forEach(button=>button.addEventListener('click',()=>{if(button.dataset.graphAction==='reset')reset();else zoom(button.dataset.graphAction==='in'?1.2:.83)}));
      viewport.addEventListener('wheel',event=>{event.preventDefault();const box=viewport.getBoundingClientRect();zoom(event.deltaY<0?1.1:.9,event.clientX-box.left,event.clientY-box.top)},{passive:false});
      viewport.addEventListener('pointerdown',event=>{if(event.target.closest('.provenance-node,.provenance-detail,button,a'))return;panning={x:event.clientX,y:event.clientY,tx,ty};viewport.setPointerCapture(event.pointerId);viewport.classList.add('dragging')});
      viewport.addEventListener('pointermove',event=>{if(!panning)return;tx=panning.tx+event.clientX-panning.x;ty=panning.ty+event.clientY-panning.y;applyTransform()});
      viewport.addEventListener('pointerup',()=>{panning=null;viewport.classList.remove('dragging')});
      const showDetail=node=>{qa('.provenance-node',world).forEach(item=>item.classList.toggle('selected',item===node));q('[data-provenance-meta]',detail).textContent=[node.dataset.year||'年份待核验',node.dataset.relation].filter(Boolean).join(' · ');q('[data-provenance-title]',detail).textContent=node.dataset.title||'';q('[data-provenance-relation]',detail).textContent=node.dataset.relation||'';q('[data-provenance-excerpt]',detail).textContent=node.dataset.excerpt||'当前论文没有可展示的连续引用语境。';const evidenceButton=q('[data-provenance-open-evidence]',detail);evidenceButton.dataset.evidenceId=node.dataset.provenanceEvidence||'';evidenceButton.hidden=!evidenceButton.dataset.evidenceId;const link=q('[data-provenance-link]',detail);if(node.dataset.url){link.href=node.dataset.url;link.hidden=false}else{link.removeAttribute('href');link.hidden=true}detail.className=`provenance-detail relation-${node.dataset.kind}`;detail.hidden=false};
      qa('.provenance-node',world).forEach(node=>{let drag=null,moved=false;node.addEventListener('pointerdown',event=>{event.stopPropagation();drag={x:event.clientX,y:event.clientY,left:node.offsetLeft,top:node.offsetTop};moved=false;node.setPointerCapture(event.pointerId)});node.addEventListener('pointermove',event=>{if(!drag)return;const dx=(event.clientX-drag.x)/scale,dy=(event.clientY-drag.y)/scale;if(Math.abs(dx)+Math.abs(dy)>4)moved=true;node.style.left=`${drag.left+dx}px`;node.style.top=`${drag.top+dy}px`;updateEdges()});node.addEventListener('pointerup',()=>{drag=null});node.addEventListener('click',event=>{event.preventDefault();if(moved){moved=false;return}showDetail(node)})});
      q('.provenance-detail-close',detail).addEventListener('click',()=>{detail.hidden=true;qa('.provenance-node',world).forEach(item=>item.classList.remove('selected'))});
      q('[data-provenance-open-evidence]',detail).addEventListener('click',event=>{if(event.currentTarget.dataset.evidenceId)openEvidence(event.currentTarget)});
      qa('[data-provenance-filter]',graph).forEach(button=>button.addEventListener('click',()=>{const kind=button.dataset.provenanceFilter;qa('[data-provenance-filter]',graph).forEach(item=>{const active=item===button;item.classList.toggle('active',active);item.setAttribute('aria-pressed',String(active))});qa('[data-kind]',world).forEach(item=>item.classList.toggle('filtered',kind!=='all'&&item.dataset.kind!==kind));detail.hidden=true}));
      addEventListener('resize',reset,{passive:true});
    });
    card.addEventListener('keydown',event=>{if(event.key==='Escape'){event.preventDefault();closeEvidence();return}if(event.key==='Tab'){const actions=qa('button:not([disabled]),a[href]',card);if(!actions.length)return;const first=actions[0],last=actions[actions.length-1];if(event.shiftKey&&document.activeElement===first){event.preventDefault();last.focus()}else if(!event.shiftKey&&document.activeElement===last){event.preventDefault();first.focus()}}});
    jump.addEventListener('click',event=>{if(jump.getAttribute('aria-disabled')==='true')event.preventDefault()});
    const dialog=q('#imageDialog'),large=q('#imageLarge'),caption=q('#imageCaption'),imageTitle=q('#imageDialogTitle'),imageJump=q('#imageJump'),imageClose=q('#imageClose');
    qa('.image-open').forEach(button=>button.addEventListener('click',()=>{imageOpener=button;const thumb=q('img',button);large.src=thumb?thumb.src:'';large.alt=button.dataset.imageAlt||'';imageTitle.textContent=button.dataset.imageTitle||'论文原图';caption.textContent=button.dataset.imageCaption||'';const page=button.dataset.imagePage;setJump(imageJump,button.dataset.imageHref||((embeddedPdfUrl()&&page)?`${pdfUrl}#page=${page}`:null),page);dialog.showModal();imageClose.focus()}));
    imageClose.addEventListener('click',()=>dialog.close());dialog.addEventListener('cancel',event=>{event.preventDefault();dialog.close()});dialog.addEventListener('close',()=>{large.removeAttribute('src');if(imageOpener&&imageOpener.isConnected)imageOpener.focus();imageOpener=null});imageJump.addEventListener('click',event=>{if(imageJump.getAttribute('aria-disabled')==='true')event.preventDefault()});
    addEventListener('beforeunload',()=>{if(pdfUrl)URL.revokeObjectURL(pdfUrl)});
  })();
  </script>
</body>
</html>
