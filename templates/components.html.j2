{% macro source_buttons(ids) -%}
  {% if ids %}<div class="source-actions" aria-label="论文原文入口">
    {% for evidence_id in ids %}<button class="source-chip" type="button" data-evidence-id="{{ evidence_id }}">查看原文{% if ids|length > 1 %} {{ loop.index }}{% endif %}</button>{% endfor %}
  </div>{% endif %}
{%- endmacro %}

{% macro narrative(item) -%}
<article class="panel summary-card narrative-card"{% if item.evidence_ids %} data-evidence-id="{{ item.evidence_ids[0] }}" role="button" tabindex="0"{% endif %}>
  <h3>{{ item.title }}</h3><p>{{ item.body }}</p>
</article>
{%- endmacro %}

{% macro narrative_flow(items, kind) -%}
{% set step_labels = {
  'research_task':'任务', 'motivation':'动因', 'method_overview':'总览',
  'method_details':'模块', 'training_inference':'阶段', 'experimental_setup':'实验',
  'main_results':'发现', 'analysis':'分析', 'conclusion_limitations':'结论',
  'existing_methods':'背景'
} %}
<div class="panel story-flow story-flow-{{ kind }}" data-story-kind="{{ kind }}">
  {% for item in items %}<article class="story-step"{% if item.evidence_ids %} data-evidence-id="{{ item.evidence_ids[0] }}" role="button" tabindex="0"{% endif %}><div class="story-marker" aria-hidden="true">{{ loop.index }}</div><div class="story-copy"><span>{{ step_labels.get(kind, '要点') }} {{ '%02d'|format(loop.index) }}</span><h3>{{ item.title }}</h3><p>{{ item.body }}</p></div></article>{% endfor %}
</div>
{%- endmacro %}

{% macro task_canvas(items) -%}
<div class="panel task-canvas">
  <div class="task-spine" aria-hidden="true"><span>研究对象</span><i>→</i><span>研究目标</span><i>→</i><span>验证问题</span></div>
  <div class="task-points">{% for item in items %}<article class="task-point"{% if item.evidence_ids %} data-evidence-id="{{ item.evidence_ids[0] }}" role="button" tabindex="0"{% endif %}><b>{{ '%02d'|format(loop.index) }}</b><div><h3>{{ item.title }}</h3><p>{{ item.body }}</p></div></article>{% endfor %}</div>
</div>
{%- endmacro %}

{% macro argument_chain(items) -%}
<div class="panel argument-chain">
  {% for item in items %}<article class="argument-node"{% if item.evidence_ids %} data-evidence-id="{{ item.evidence_ids[0] }}" role="button" tabindex="0"{% endif %}><span>{{ ['观察','缺口','设计要求','核心主张'][loop.index0] if loop.index0 < 4 else '推论' }}</span><h3>{{ item.title }}</h3><p>{{ item.body }}</p></article>{% if not loop.last %}<i aria-hidden="true">→</i>{% endif %}{% endfor %}
</div>
{%- endmacro %}

{% macro method_map(items) -%}
<div class="panel method-map" data-method-flow>
  <div class="method-map-note"><b>方法流</b><span>点击阶段定位正文；下方论文原方法图会同步突出。</span></div>
  <div class="method-stages">{% for item in items %}<article class="method-stage" data-method-step="{{ loop.index0 }}"{% if item.evidence_ids %} data-evidence-id="{{ item.evidence_ids[0] }}" role="button" tabindex="0"{% endif %}><span>{{ '%02d'|format(loop.index) }}</span><h3>{{ item.title }}</h3><p>{{ item.body }}</p></article>{% endfor %}</div>
</div>
{%- endmacro %}

{% macro execution_track(items) -%}
<div class="panel execution-track">
  <div class="track-label"><b>论文流程</b><span>从数据准备到执行输出</span></div>
  <div class="track-rail">{% for item in items %}<article{% if item.evidence_ids %} data-evidence-id="{{ item.evidence_ids[0] }}" role="button" tabindex="0"{% endif %}><span>阶段 {{ loop.index }}</span><h3>{{ item.title }}</h3><p>{{ item.body }}</p></article>{% endfor %}</div>
</div>
{%- endmacro %}

{% macro experiment_blueprint(items) -%}
<div class="panel experiment-blueprint">
  <div class="blueprint-legend"><span>对象 / 数据</span><span>对照 / 设置</span><span>指标 / 观察</span></div>
  {% for item in items %}<article{% if item.evidence_ids %} data-evidence-id="{{ item.evidence_ids[0] }}" role="button" tabindex="0"{% endif %}><b>实验 {{ '%02d'|format(loop.index) }}</b><div><h3>{{ item.title }}</h3><p>{{ item.body }}</p></div></article>{% endfor %}
</div>
{%- endmacro %}

{% macro result_ledger(items) -%}
<div class="panel result-ledger">
  {% for item in items %}<article{% if item.evidence_ids %} data-evidence-id="{{ item.evidence_ids[0] }}" role="button" tabindex="0"{% endif %}><span>R{{ loop.index }}</span><div><h3>{{ item.title }}</h3><p>{{ item.body }}</p></div><b>证据 ↗</b></article>{% endfor %}
</div>
{%- endmacro %}

{% macro diagnostic_matrix(items) -%}
<div class="panel diagnostic-matrix">
  {% for item in items %}<article{% if item.evidence_ids %} data-evidence-id="{{ item.evidence_ids[0] }}" role="button" tabindex="0"{% endif %}><span>{{ ['机制','效率','鲁棒性','失败模式'][loop.index0] if loop.index0 < 4 else '补充' }}</span><h3>{{ item.title }}</h3><p>{{ item.body }}</p></article>{% endfor %}
</div>
{%- endmacro %}

{% macro boundary_map(items) -%}
<div class="panel boundary-map">
  <div class="boundary-axis" aria-hidden="true"><span>论文可以支持</span><span>仍需谨慎</span></div>
  {% for item in items %}<article class="boundary-item boundary-{{ 'claim' if loop.index0 == 0 else 'limit' }}"{% if item.evidence_ids %} data-evidence-id="{{ item.evidence_ids[0] }}" role="button" tabindex="0"{% endif %}><span>{{ '结论' if loop.index0 == 0 else '边界 ' ~ loop.index }}</span><h3>{{ item.title }}</h3><p>{{ item.body }}</p></article>{% endfor %}
</div>
{%- endmacro %}

{% macro narrative_group(items, kind, presentation) -%}
  {% if presentation == 'task_canvas' %}{{ task_canvas(items) }}
  {% elif presentation == 'argument_chain' %}{{ argument_chain(items) }}
  {% elif presentation == 'method_map' %}{{ method_map(items) }}
  {% elif presentation == 'execution_track' %}{{ execution_track(items) }}
  {% elif presentation == 'experiment_blueprint' %}{{ experiment_blueprint(items) }}
  {% elif presentation == 'result_ledger' %}{{ result_ledger(items) }}
  {% elif presentation == 'diagnostic_matrix' %}{{ diagnostic_matrix(items) }}
  {% elif presentation == 'boundary_map' %}{{ boundary_map(items) }}
  {% else %}{{ narrative_flow(items, kind) }}{% endif %}
{%- endmacro %}

{% macro quick_read(items) -%}
<div class="panel quick-read-grid">
  {% for item in items %}<article class="quick-read-cell"{% if item.evidence_ids %} data-evidence-id="{{ item.evidence_ids[0] }}" role="button" tabindex="0"{% endif %}><span>0{{ loop.index }}</span><h3>{{ item.title }}</h3><p>{{ item.body }}</p></article>{% endfor %}
</div>
{%- endmacro %}

{% macro formula(item) -%}
<article class="panel formula-card">
  <div class="component-head"><div><span class="component-label">论文公式{% if item.label %} · {{ item.label }}{% endif %}</span><h3>{{ item.title }}</h3></div>{% if item.href %}<a class="page-link" href="{{ item.href }}" target="_blank" rel="noopener noreferrer">p.{{ item.page }} ↗</a>{% elif item.page %}<span class="page-text">p.{{ item.page }}</span>{% endif %}</div>
  <div class="formula-scroll" tabindex="0" aria-label="可横向滚动的公式">
    {{ item.mathml|safe }}
  </div>
  {% if item.render_note %}<p class="render-note" role="status">{{ item.render_note }}</p>{% endif %}
</article>
{%- endmacro %}

{% macro figure(item) -%}
<figure class="panel paper-figure">
  <div class="component-head"><span class="component-label original-label">{{ item.label }}</span>{% if item.href %}<a class="page-link" href="{{ item.href }}" target="_blank" rel="noopener noreferrer">p.{{ item.page }} ↗</a>{% elif item.page %}<span class="page-text">p.{{ item.page }}</span>{% endif %}</div>
  {% if item.asset_data_uri %}<button class="image-open" type="button" data-image-alt="{{ item.alt }}" data-image-title="{{ item.title }}" data-image-caption="{{ item.caption or '' }}" data-image-href="{{ item.href or '' }}" data-image-page="{{ item.page or '' }}" aria-label="放大查看 {{ item.title }}"><img src="{{ item.asset_data_uri }}" alt="{{ item.alt }}"></button>{% else %}<div class="asset-missing" role="status">原图资源未写入，等待人工审核。</div>{% endif %}
  {% if item.caption %}<figcaption><b>{{ item.title }}</b><span>{{ item.caption }}</span></figcaption>{% endif %}
</figure>
{%- endmacro %}

{% macro table(item) -%}
<figure class="panel paper-table">
  <div class="component-head"><span class="component-label original-label">论文原表</span>{% if item.href %}<a class="page-link" href="{{ item.href }}" target="_blank" rel="noopener noreferrer">p.{{ item.page }} ↗</a>{% elif item.page %}<span class="page-text">p.{{ item.page }}</span>{% endif %}</div>
  {% if item.columns and item.rows %}<div class="scroll-region" tabindex="0" aria-label="论文表格，可横向滚动"><table><thead><tr>{% for column in item.columns %}<th scope="col">{{ column }}</th>{% endfor %}</tr></thead><tbody>{% for row in item.rows %}{% set row_index = loop.index0 %}<tr>{% for cell in row %}{% set key = row_index|string ~ ':' ~ loop.index0|string %}<td>{% if key in item.interactive_cells %}<button class="cell-evidence" type="button" data-evidence-id="{{ item.interactive_cells[key] }}" aria-label="查看该数据点的论文原文">{{ cell }}</button>{% else %}{{ cell }}{% endif %}</td>{% endfor %}</tr>{% endfor %}</tbody></table></div>{% elif item.asset_data_uri %}<button class="image-open" type="button" data-image-alt="{{ item.alt }}" data-image-title="{{ item.title }}" data-image-caption="{{ item.caption or '' }}" data-image-href="{{ item.href or '' }}" data-image-page="{{ item.page or '' }}" aria-label="放大查看论文原表"><img src="{{ item.asset_data_uri }}" alt="{{ item.alt }}"></button>{% else %}<div class="asset-missing" role="status">表格内容未可靠抽取，等待人工审核。</div>{% endif %}
  {% if item.caption %}<figcaption>{{ item.caption }}</figcaption>{% endif %}
</figure>
{%- endmacro %}

{% macro derived_visual(item) -%}
<figure class="panel derived-visual">
  <div class="component-head"><div><span class="component-label derived-label">{{ item.label }}</span><h3>{{ item.title }}</h3></div></div>
  <div class="scroll-region visual-scroll" tabindex="0" aria-label="{{ item.title }}，可横向滚动"><svg viewBox="{{ item.view_box|join(' ') }}" role="img" aria-labelledby="{{ item.id }}-title {{ item.id }}-desc"><title id="{{ item.id }}-title">{{ item.title }}</title><desc id="{{ item.id }}-desc">{{ item.description }}</desc><defs><marker id="arrow-{{ item.id }}" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto"><path d="M0 0 L8 4 L0 8Z"></path></marker></defs>
    {% for edge in item.edges %}<line class="graph-edge {{ edge.line }}" x1="{{ edge.x1 }}" y1="{{ edge.y1 }}" x2="{{ edge.x2 }}" y2="{{ edge.y2 }}"{% if edge.marker == 'arrow' %} marker-end="url(#arrow-{{ item.id }})"{% endif %}></line>{% endfor %}
    {% for node in item.nodes %}<g class="graph-node{% if node.evidence_id %} interactive{% endif %}" transform="translate({{ node.position.x }} {{ node.position.y }})"{% if node.evidence_id %} role="button" tabindex="0" data-evidence-id="{{ node.evidence_id }}" aria-label="查看 {{ node.label }} 的论文原文"{% endif %}><rect width="{{ node.size.width }}" height="{{ node.size.height }}" rx="{% if node.shape == 'rounded_rect' %}16{% else %}5{% endif %}"></rect><text x="{{ node.size.width / 2 }}" y="{{ node.size.height / 2 }}">{{ node.label|truncate(54, true, '…') }}</text></g>{% endfor %}
    {% for mark in item.marks %}<g class="graph-mark{% if mark.evidence_id %} interactive{% endif %}"{% if mark.evidence_id %} role="button" tabindex="0" data-evidence-id="{{ mark.evidence_id }}" aria-label="查看 {{ mark.label }} 的论文原文"{% endif %}><rect x="{{ mark.position.x }}" y="{{ mark.position.y }}" width="{{ mark.size.width }}" height="{{ mark.size.height }}" rx="4"></rect><text x="{{ mark.position.x + mark.size.width / 2 }}" y="{{ mark.position.y - 10 }}">{{ mark.label|truncate(26, true, '…') }}</text><text x="{{ mark.position.x + mark.size.width / 2 }}" y="{{ mark.position.y + mark.size.height + 24 }}">{{ mark.value }}</text></g>{% endfor %}
  </svg></div><figcaption><b>派生图。</b> {{ item.description }}</figcaption>
</figure>
{%- endmacro %}

{% macro citation(item) -%}
<article class="panel citation-card"><span class="verification">{{ item.verification }}</span><h3>{{ item.title }}</h3>{% if item.authors %}<p>{{ item.authors|join('、') }}{% if item.year %} · {{ item.year }}{% endif %}</p>{% endif %}<div class="citation-actions">{{ source_buttons(item.evidence_ids) }}{% if item.url %}<a href="{{ item.url }}" target="_blank" rel="noopener noreferrer">论文入口 ↗</a>{% endif %}</div></article>
{%- endmacro %}

{% macro related_work(item) -%}
<div class="related-stack">
  <figure class="panel provenance-graph" data-provenance-graph>
    <div class="component-head"><div><span class="component-label derived-label">研究溯源</span><h3>哪些工作汇聚成了本文</h3><p>从左向右阅读：论文来源 → 影响类型 → 当前论文。</p></div><div class="provenance-zoom" aria-label="图谱缩放"><button type="button" data-graph-action="out" aria-label="缩小">−</button><button type="button" data-graph-action="reset">复位</button><button type="button" data-graph-action="in" aria-label="放大">＋</button></div></div>
    {% if item.relation_groups %}<div class="provenance-filters" role="group" aria-label="按来源类型筛选"><button type="button" class="active" data-provenance-filter="all" aria-pressed="true">全部 {{ item.nodes|length }}</button>{% for group in item.relation_groups %}<button type="button" data-provenance-filter="{{ group.kind }}" aria-pressed="false"><i class="relation-dot relation-{{ group.kind }}"></i>{{ group.label }} {{ group.nodes|length }}</button>{% endfor %}</div>
    <div class="provenance-viewport" tabindex="0" aria-label="论文研究溯源网络，可拖动画布、滚轮缩放、拖动论文节点">
      <div class="provenance-world" style="width:{{ item.canvas.width }}px;height:{{ item.canvas.height }}px">
        <svg class="provenance-edges" width="{{ item.canvas.width }}" height="{{ item.canvas.height }}" viewBox="0 0 {{ item.canvas.width }} {{ item.canvas.height }}" aria-hidden="true"><defs><marker id="provenance-arrow" markerWidth="9" markerHeight="9" refX="8" refY="4.5" orient="auto"><path d="M0 0 L9 4.5 L0 9Z"></path></marker></defs>{% for edge in item.graph_edges %}<path class="provenance-edge relation-{{ edge.kind }}{% if not edge.semantic %} provenance-trunk{% endif %}" data-source-node="{{ edge.source_id }}" data-target-node="{{ edge.target_id }}" data-kind="{{ edge.kind }}" marker-end="url(#provenance-arrow)"></path>{% endfor %}</svg>
        {% for group in item.relation_groups %}<div class="provenance-lane relation-{{ group.kind }}" data-kind="{{ group.kind }}" style="top:{{ group.position.y }}px;height:{{ group.position.height }}px"><span>{{ group.label }}</span></div>{% endfor %}
        {% for node in item.nodes %}<button type="button" class="provenance-node relation-{{ node.relation_kind }}" data-node-id="{{ node.id }}" data-kind="{{ node.relation_kind }}" data-provenance-evidence="{{ node.evidence_id or '' }}" data-title="{{ node.title }}" data-year="{{ node.year or '' }}" data-relation="{{ node.relation_label or '' }}" data-excerpt="{{ node.evidence_excerpt or '' }}" data-url="{{ node.url or '' }}" style="left:{{ node.position.x }}px;top:{{ node.position.y }}px;width:{{ node.size.width }}px;height:{{ node.size.height }}px" aria-label="{{ node.title }}，{{ node.relation_label }}"><small>{{ node.year or '年份待核验' }}</small><strong>{{ node.title }}</strong></button>{% endfor %}
        {% for hub in item.hubs %}<div class="provenance-hub relation-{{ hub.kind }}" data-node-id="{{ hub.id }}" data-kind="{{ hub.kind }}" style="left:{{ hub.position.x }}px;top:{{ hub.position.y }}px;width:{{ hub.size.width }}px;height:{{ hub.size.height }}px"><span>{{ hub.label }}</span><b>{{ hub.count }}</b></div>{% endfor %}
        <div class="provenance-terminal" data-node-id="{{ item.current_node.id }}" style="left:{{ item.current_node.position.x }}px;top:{{ item.current_node.position.y }}px;width:{{ item.current_node.size.width }}px;height:{{ item.current_node.size.height }}px"><small>当前论文 · 最终节点</small><strong>{{ item.current_node.title }}</strong>{% if item.current_node.year %}<time>{{ item.current_node.year }}</time>{% endif %}</div>
      </div>
    </div>
    <aside class="provenance-detail" hidden aria-live="polite"><button type="button" class="provenance-detail-close" aria-label="关闭节点详情">×</button><small data-provenance-meta></small><h4 data-provenance-title></h4><p data-provenance-relation></p><blockquote data-provenance-excerpt></blockquote><div><button type="button" class="text-button" data-provenance-open-evidence>定位本文引用语境</button><a data-provenance-link target="_blank" rel="noopener noreferrer">打开论文 ↗</a></div></aside>
    {% else %}<div class="related-empty">当前论文确实包含 Related Work，但尚未抽取出可安全对应到具体论文的条目。</div>{% endif %}
    <figcaption><b>证据约束图。</b> 每条语义边都来自本文中同时包含引用标记和关系表达的连续原文；节点大小不表示引用量。</figcaption>
  </figure>
</div>
{%- endmacro %}

{% macro component(item) -%}
  {% if item.component == 'narrative' %}{{ narrative(item) }}{% elif item.component == 'formula' %}{{ formula(item) }}{% elif item.component == 'figure' %}{{ figure(item) }}{% elif item.component == 'table' %}{{ table(item) }}{% elif item.component == 'derived_visual' %}{{ derived_visual(item) }}{% elif item.component == 'citation' %}{{ citation(item) }}{% elif item.component == 'related_work' %}{{ related_work(item) }}{% endif %}
{%- endmacro %}
