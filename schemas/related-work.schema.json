{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paper-visualizer.local/schemas/related-work.schema.json",
  "title": "Paper Visualizer Related Work Plan",
  "type": "object",
  "required": ["schema_version", "stage_version", "paper_id", "source_ir_sha256", "policy", "current_paper", "nodes", "clusters", "edges", "review"],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "stage_version": {"type": "string", "minLength": 1},
    "paper_id": {"$ref": "#/$defs/id"},
    "source_ir_sha256": {"$ref": "#/$defs/sha256"},
    "policy": {
      "type": "object",
      "required": ["description_source", "external_data_scope", "edge_meaning", "node_size_meaning", "category_quota", "graph_purpose", "edge_direction", "layout_direction"],
      "properties": {
        "description_source": {"const": "current_paper_verbatim_evidence_only"},
        "external_data_scope": {"const": "metadata_and_relationship_verification_only"},
        "edge_meaning": {"const": "four_evidence_grounded_relation_families"},
        "node_size_meaning": {"const": "uniform_no_citation_count_encoding"},
        "category_quota": {"const": "none"},
        "graph_purpose": {"const": "evidence_grounded_research_provenance"},
        "edge_direction": {"const": "source_to_current_paper"},
        "layout_direction": {"const": "left_to_right_terminal"}
      },
      "additionalProperties": false
    },
    "current_paper": {"$ref": "#/$defs/current_paper"},
    "nodes": {"type": "array", "items": {"$ref": "#/$defs/node"}},
    "clusters": {"type": "array", "items": {"$ref": "#/$defs/cluster"}},
    "edges": {"type": "array", "items": {"$ref": "#/$defs/edge"}},
    "review": {"$ref": "#/$defs/review"}
  },
  "additionalProperties": false,
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9._:-]{2,127}$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "metadata": {
      "type": "object",
      "required": ["title", "authors", "year", "url"],
      "properties": {
        "title": {"type": ["string", "null"]},
        "authors": {"type": "array", "items": {"type": "string"}},
        "year": {"type": ["integer", "null"]},
        "url": {"type": ["string", "null"], "pattern": "^https?://"},
        "doi": {"type": ["string", "null"]},
        "venue": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["provider", "record_id", "url"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "record_id": {"type": ["string", "null"]},
        "url": {"type": ["string", "null"], "pattern": "^https?://"},
        "retrieved_at": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "verification": {
      "type": "object",
      "required": ["status", "checked_fields", "conflicts", "sources"],
      "properties": {
        "status": {"enum": ["verified", "partial", "unverified", "conflict"]},
        "checked_fields": {"type": "array", "items": {"enum": ["title", "authors", "year", "url", "relationship"]}},
        "conflicts": {"type": "array", "items": {"type": "string"}},
        "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}}
      },
      "additionalProperties": false
    },
    "current_paper": {
      "type": "object",
      "required": ["id", "metadata", "verification"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "metadata": {"$ref": "#/$defs/metadata"},
        "verification": {"$ref": "#/$defs/verification"}
      },
      "additionalProperties": false
    },
    "description": {
      "type": "object",
      "required": ["kind", "evidence_ids", "display_policy"],
      "properties": {
        "kind": {"const": "current_paper_verbatim"},
        "evidence_ids": {"type": "array", "items": {"$ref": "#/$defs/id"}},
        "display_policy": {"const": "dereference_verbatim_text"}
      },
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "required": ["id", "citation_id", "raw_reference", "metadata", "description", "cluster_ids", "verification"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "citation_id": {"$ref": "#/$defs/id"},
        "raw_reference": {"type": "string", "minLength": 1},
        "metadata": {"$ref": "#/$defs/metadata"},
        "description": {"$ref": "#/$defs/description"},
        "cluster_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}},
        "verification": {"$ref": "#/$defs/verification"}
      },
      "additionalProperties": false
    },
    "cluster": {
      "type": "object",
      "required": ["id", "label", "description", "member_node_ids", "basis_evidence_ids", "basis"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "label": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "member_node_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}},
        "basis_evidence_ids": {"type": "array", "items": {"$ref": "#/$defs/id"}},
        "basis": {"const": "current_paper_context"}
      },
      "additionalProperties": false
    },
    "edge": {
      "type": "object",
      "required": ["id", "source_id", "target_id", "kind", "cluster_id", "basis_evidence_ids", "verification"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "source_id": {"$ref": "#/$defs/id"},
        "target_id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["foundation_inheritance", "same_problem", "improvement_comparison", "data_evaluation"]},
        "cluster_id": {"$ref": "#/$defs/id"},
        "basis_evidence_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}},
        "verification": {"const": "verified"}
      },
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "required": ["status", "warnings", "needs_human_review"],
      "properties": {
        "status": {"enum": ["passed", "needs_review"]},
        "warnings": {"type": "array", "items": {"type": "string"}},
        "needs_human_review": {"type": "array", "items": {"type": "object"}}
      },
      "additionalProperties": false
    }
  }
}
